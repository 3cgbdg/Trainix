MONGO_URI=
JWT_SECRET=
PORT=
CORS_ORIGIN=
UNSPLASH_ACCESS_KEY=
REGION_NAME=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# the separate Python AI/CV service. Only the backend talks to it now -- the
# browser reaches it through /api/measurement/analyze and the plan endpoints, so
# this service does not need public ingress.
PYTHON_API_URL=
# shared secret the backend sends as "x-ai-service-secret" so the AI service can
# reject anything that didn't come from us. Generate with `openssl rand -hex 32`.
# Optional until the Python side enforces it.
AI_SERVICE_SECRET=

# frontend -> backend. NEXT_PUBLIC_API_URL is used for SSR and the Socket.IO
# handshake; browser REST calls go through the Next.js rewrite proxy.
NEXT_PUBLIC_API_URL=
API_URL=

# frontend origin, used to build links in emails (e.g. password reset)
FRONTEND_URL=

# transactional email (password reset, digests). Leave blank to skip sending
# and log to the console instead -- fine for local dev.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# error monitoring (backend)
SENTRY_DSN=
# error monitoring (frontend -- same Sentry project or a separate one, your call)
NEXT_PUBLIC_SENTRY_DSN=
# only needed at build time, to upload source maps -- leave blank to skip that step
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# subscription billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# shared secret for POST /api/internal/cron (header "x-cron-secret") - lets an
# external scheduler force the daily cron jobs to run even if the free-tier dyno was
# asleep at their scheduled time. Generate with `openssl rand -hex 32`.
CRON_SECRET=
